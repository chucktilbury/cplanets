# TUNING-PLAYABLE C3 — trade-leaning closed fixture.
# Same schema as closed-default.setup; trade / cover knobs skewed
# for A/B vs combat. Magnitudes are placeholders.
# Re-run with the same --seed for a comparable galaxy layout.

# --- clock ---
scenario_mode = closed
tick_period_seconds = 5
tick_auto_config_from_ai_lag = false
ai_reaction_lag_ticks = 1
ai_reaction_lag_seconds = 5.0
afk_timeout_seconds = 120.0
afk_shrink_factor = 1.0

# --- galaxy ---
# REFERENCE fragment — fold into config/server-*.cfg (unified).
# Server no longer loads setup= PATH / --setup. See doc/SERVER-CONFIG.md.
world_count = 16
useful_mix = 0.45
scout_range = 3.5
galaxy_radius = 16.0

# --- identify ---
identify_attacker_base = 0.30
identify_attacker_per_attr = 0.04
identify_defender_base = 0.18
identify_defender_per_attr = 0.03

# --- travel / combat / tech ---
tech_range_base = 3.0
tech_range_per_tech = 0.5
tech_teleport_threshold = 10.0
tech_teleport_enabled = true
attack_bump = 0.85
pirate_attrition = 0.20
pirate_leftover = 0.04
pirate_idle_ticks = 12
battle_strength_duration_coeff = 0.90
battle_short_circuit_gap = 3.5
productive_inherent_defense = 1.0
stranded_ticks_n = 5
voyage_cost = 0.0

# --- economy / design / dispatch (trade lean) ---
design_develop_ticks = 4
yard_build_ticks = 2
design_speed_cost_coeff = 1.0
design_range_cost_coeff = 1.0
reclaim_percent = 0.55
capture_use_chance = 0.20
cover_factor = 1.15
trade_bump = 1.45
dispatch_weight_scout = 0.12
dispatch_weight_colony = 4.5
start_wealth = 1200.0
start_resources = 600.0
start_tech = 1.0
start_power = 1.0
start_experience = 0.0

# --- production / yard / design cost bases ---
production_tick_rate = 0.01
yard_build_cost_per_size = 10.0
design_develop_cost_per_size = 50.0
colony_hop_fraction = 0.5

# --- galaxy spawn fractions / fallbacks ---
home_spawn_min_radius_fraction = 0.25
home_spawn_max_radius_fraction = 0.95
home_spawn_min_radius_floor = 0.5
useful_livability_fraction = 0.6
poor_livability_fraction = 0.2
poor_resources_fraction = 0.5
home_fallback_livability = 50.0
home_fallback_resources = 50.0
contact_reach = 4.0

# --- default hull template magnitudes ---
design_scout_speed = 2.0
design_scout_size = 0.5
design_colony_speed = 1.0
design_colony_size = 5.0
design_colony_hold = 10.0
design_freighter_speed = 1.0
design_freighter_size = 2.0
design_freighter_hold = 10.0
design_escort_speed = 1.5
design_escort_size = 3.0
design_frigate_speed = 1.5
design_frigate_size = 2.0
design_destroyer_speed = 1.0
design_destroyer_size = 8.0

# --- display (livability 1–10 mapping) ---
livability_internal_min = 0.0
livability_internal_max = 100.0
livability_display_min = 1
livability_display_max = 10
