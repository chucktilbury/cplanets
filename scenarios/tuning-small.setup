# TUNING-PLAYABLE C3 — small closed fixture for fast balance loops.
# Same schema as closed-default.setup; fewer worlds / tighter map.
# Magnitudes are placeholders until RULES locks them.
# Re-run with the same --seed for a comparable galaxy layout.

# --- clock ---
scenario_mode = closed
tick_period_seconds = 5
tick_auto_config_from_ai_lag = false
ai_reaction_lag_ticks = 1
ai_reaction_lag_seconds = 5.0
afk_timeout_seconds = 120.0
afk_shrink_factor = 1.0

# --- galaxy (small) ---
world_count = 12
useful_mix = 0.40
scout_range = 3.0
galaxy_radius = 12.0

# --- identify ---
identify_attacker_base = 0.35
identify_attacker_per_attr = 0.05
identify_defender_base = 0.20
identify_defender_per_attr = 0.04

# --- travel / combat / tech ---
tech_range_base = 3.0
tech_range_per_tech = 0.5
tech_teleport_threshold = 10.0
tech_teleport_enabled = true
attack_bump = 1.0
pirate_attrition = 0.30
pirate_leftover = 0.05
pirate_idle_ticks = 10
battle_strength_duration_coeff = 1.0
battle_short_circuit_gap = 3.0
productive_inherent_defense = 1.0
stranded_ticks_n = 5
voyage_cost = 0.0

# --- economy / design / dispatch ---
design_develop_ticks = 5
yard_build_ticks = 3
design_speed_cost_coeff = 1.0
design_range_cost_coeff = 1.0
reclaim_percent = 0.50
capture_use_chance = 0.25
cover_factor = 1.0
trade_bump = 1.20
dispatch_weight_scout = 0.1
dispatch_weight_colony = 5.0
start_wealth = 1000.0
start_resources = 500.0
start_tech = 1.0
start_power = 1.0
start_experience = 0.0

# --- display (livability 1–10 mapping) ---
livability_internal_min = 0.0
livability_internal_max = 100.0
livability_display_min = 1
livability_display_max = 10
