# CPlanets closed-scenario default fixture (RULES §14 / PLAN §4.B).
# Application text: key = value. Magnitudes are placeholders.
# scenario_mode default = closed (eliminate all others).
#
# TUNING SURFACE (workstream A) — edit here, restart the server.
# Groups align with RULES §14 / DIALOGS setup outline. Unknown keys
# fail loud at load. Mid-game retune is not supported: stop the
# process, edit, start again with the same --setup / --seed.

# --- clock ---
scenario_mode = closed
tick_period_seconds = 5
tick_auto_config_from_ai_lag = true
ai_reaction_lag_ticks = 1
# Matches tick_period_seconds so auto-config is a no-op here.
ai_reaction_lag_seconds = 5.0
afk_timeout_seconds = 120.0
afk_shrink_factor = 1.0
# Server stdout verbosity 0–10 (clamped). Provisional: 0 errors
# only, 3+ settings PUTs, 6+ combat, 10 full dumps. CLI
# --verbosity overlays this when provided.
verbosity = 0

# --- galaxy ---
world_count = 24
useful_mix = 0.35
scout_range = 3.0
galaxy_radius = 20.0

# --- identify ---
identify_attacker_base = 0.35
identify_attacker_per_attr = 0.05
identify_defender_base = 0.20
identify_defender_per_attr = 0.04

# --- travel / combat / tech ---
tech_range_base = 3.0
tech_range_per_tech = 0.5
tech_teleport_threshold = 10.0
tech_teleport_enabled = true
attack_bump = 1.0
pirate_attrition = 0.30
pirate_leftover = 0.05
pirate_idle_ticks = 10
battle_strength_duration_coeff = 1.0
battle_short_circuit_gap = 3.0
productive_inherent_defense = 1.0
stranded_ticks_n = 5
voyage_cost = 0.0

# --- economy / design / dispatch ---
design_develop_ticks = 5
yard_build_ticks = 3
design_speed_cost_coeff = 1.0
design_range_cost_coeff = 1.0
reclaim_percent = 0.50
capture_use_chance = 0.25
cover_factor = 1.0
trade_bump = 1.20
dispatch_weight_scout = 0.1
dispatch_weight_colony = 5.0
start_wealth = 1000.0
start_resources = 500.0
start_tech = 1.0
start_power = 1.0
start_experience = 0.0

# --- display (livability 1–10 mapping) ---
livability_internal_min = 0.0
livability_internal_max = 100.0
livability_display_min = 1
livability_display_max = 10
