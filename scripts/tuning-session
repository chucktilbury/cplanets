#!/usr/bin/env bash
# scripts/tuning-session — start a closed tuning session (server + AI).
#
# Human attaches separately with --gui or headless --pull. Same
# --config + --seed yields a comparable galaxy after knob edits
# (restart contract; TUNING-PLAYABLE workstream C).
#
# Prefer: ./scripts/setup && build, then run this from the project root.

set -o errexit -o nounset -o pipefail

usage() {
    cat <<'EOF' >&2
Usage: scripts/tuning-session [options]

  --config PATH    Unified server config (default: config/server-tuning-small.cfg)
  --setup PATH     Deprecated alias for --config (migration)
  --seed N         Galaxy PRNG seed (default: 77)
  --port N         Listen port (default: 7700)
  --players N      Soft max seats (default: 2)
  --ai-config PATH AI config (default: config/ai-mid.cfg)
  --ai-cycles N    AI --serve-loop cycles (default: 0 = until
                   eliminated / game ended / process stop;
                   pass >0 for a short smoke, then AI exits)
  --no-ai          Start server only
  --injectable     Enable admin advance clock (CI / harness)
  --help           This help

Prints PORT=/SEED=/CONFIG= lines, then leaves server (and optional AI)
in the foreground group. Stop with Ctrl-C (kills both).

Comparable loop after a knob edit:
  1. Edit the --config and/or --ai-config file.
  2. Stop this script (Ctrl-C).
  3. Re-run with the same --config --seed --ai-config.
  4. Attach the human client again (same --port; seat from handshake).
EOF
    exit 2
}

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

server_config="config/server-tuning-small.cfg"
seed=77
port=7700
players=2
ai_config="config/ai-mid.cfg"
ai_cycles=0
start_ai=true
injectable=false

while [[ $# -gt 0 ]]; do
    case "$1" in
    --config|--setup)
        server_config="${2:-}"
        shift 2
        ;;
    --seed)
        seed="${2:-}"
        shift 2
        ;;
    --port)
        port="${2:-}"
        shift 2
        ;;
    --players)
        players="${2:-}"
        shift 2
        ;;
    --ai-config)
        ai_config="${2:-}"
        shift 2
        ;;
    --ai-cycles)
        ai_cycles="${2:-}"
        shift 2
        ;;
    --no-ai)
        start_ai=false
        shift
        ;;
    --injectable)
        injectable=true
        shift
        ;;
    --help|-h)
        usage
        ;;
    *)
        printf 'Unknown argument: %s\n' "$1" >&2
        usage
        ;;
    esac
done

server_bin="bin/cplanets-server"
ai_bin="bin/cplanets-ai"
if [[ ! -x "$server_bin" ]]; then
    printf 'Missing %s — run ./scripts/setup then build.\n' \
        "$server_bin" >&2
    exit 1
fi
if [[ ! -f "$server_config" ]]; then
    printf 'Missing server config: %s\n' "$server_config" >&2
    exit 1
fi
if [[ "$start_ai" == true ]]; then
    if [[ ! -x "$ai_bin" ]]; then
        printf 'Missing %s — run build.\n' "$ai_bin" >&2
        exit 1
    fi
    if [[ ! -f "$ai_config" ]]; then
        printf 'Missing AI config: %s\n' "$ai_config" >&2
        exit 1
    fi
fi

server_args=(
    --config "$server_config"
    --serve
    --host 127.0.0.1
    --port "$port"
    --players "$players"
    --seed "$seed"
)
if [[ "$injectable" == true ]]; then
    server_args+=(--injectable)
fi

server_pid=""
ai_pid=""
cleanup() {
    if [[ -n "$ai_pid" ]] && kill -0 "$ai_pid" 2>/dev/null; then
        kill "$ai_pid" 2>/dev/null || true
        wait "$ai_pid" 2>/dev/null || true
    fi
    if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

printf 'Starting server: config=%s seed=%s port=%s\n' \
    "$server_config" "$seed" "$port"
"$server_bin" "${server_args[@]}" &
server_pid=$!

# Give PORT= a moment; operator still uses the requested --port.
sleep 0.3
if ! kill -0 "$server_pid" 2>/dev/null; then
    wait "$server_pid" || true
    printf 'Server exited early.\n' >&2
    exit 1
fi

if [[ "$start_ai" == true ]]; then
    # Override dial from CLI so presets can keep port=0 in-file.
    ai_args=(
        --config "$ai_config"
        --host 127.0.0.1
        --port "$port"
        --serve-loop
    )
    # cycles 0 (default) = continuous until eliminated/ended/stop.
    ai_args+=(--cycles "$ai_cycles")
    printf 'Starting AI: config=%s (CLI port=%s)\n' \
        "$ai_config" "$port"
    "$ai_bin" "${ai_args[@]}" &
    ai_pid=$!
fi

cat <<EOF

Harness running.
  Server PID: ${server_pid}
  AI PID:     ${ai_pid:-none}
  Seed:       ${seed}  (keep this fixed for comparable re-runs)
  Config:     ${server_config}
  AI config:  ${ai_config}

Human GTK (seat from handshake):
  bin/cplanets --config config/human-default.cfg \\
    --host 127.0.0.1 --port ${port} --gui

Headless human smoke:
  bin/cplanets --config config/human-default.cfg \\
    --host 127.0.0.1 --port ${port} --pull

Unified server packs: config/server-tuning-small.cfg,
  config/server-tuning-combat.cfg, config/server-tuning-trade.cfg,
  config/server-default.cfg
  (scenarios/*.setup are reference fragments only)
AI bands: config/ai-soft.cfg, config/ai-mid.cfg, config/ai-hard.cfg
  Default config/ai-default.cfg.

Ctrl-C stops server and AI.
EOF

wait "$server_pid"
